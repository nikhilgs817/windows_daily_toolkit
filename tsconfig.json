{
 "compilerOptions": {
  "target": "ES2022",
  "module": "ES2022",
  "moduleResolution": "Bundler",
  "lib": [
   "ES2022"
  ],
  "types": [
   "node"
  ],
  "strict": true,
  "noImplicitOverride": true,
  "allowJs": true,
  "checkJs": false,
  "skipLibCheck": true,
  "esModuleInterop": true,
  "customConditions": [
   "node"
  ]
 },
 "include": [
  "shared/**/*.ts",
  "shared/**/*.js",
  "plugins/*/src/**/*.ts"
 ]
}